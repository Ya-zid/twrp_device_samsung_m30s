on init
    write /proc/sys/kernel/hung_task_timeout_secs 0

on late-init
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb

on fs
    wait /dev/block/platform/13520000.ufs
    symlink /dev/block/platform/13520000.ufs /dev/block/bootdevice
    symlink /dev/block/platform/13520000.ufs/by-name /dev/block/by-name
    start hwservicemanager

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

on boot
    start health-hal-2-1

# ---------------------------------------------------------------------------
# Data decryption: Samsung's key services, taken from the phone's own vendor
# partition by m30s_tee.sh. Users, groups and folders are the ones the stock
# firmware uses (teegris_v3.rc, keymaster and gatekeeper service rc files), so
# files these daemons create belong to the same user as in a normal boot.
# All are oneshot: one that cannot run must not be restarted every 5 seconds.
# ---------------------------------------------------------------------------
on post-fs
    start m30s-tee

on property:m30s.tee.prep=done
    start tz_service

on property:vendor.tzdaemon=Ready
    setprop vendor.TEEGRIS.loaded true
    start tzts_service
    start vendor.keymaster-4-0
    start vendor.gatekeeper-1-0

service m30s-tee /system/bin/m30s_tee.sh
    user root
    group root system
    seclabel u:r:recovery:s0
    oneshot
    disabled

service tz_service /vendor/bin/tzdaemon
    user system
    group system readproc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/tee/vndk/lib64:/system/lib64
    seclabel u:r:recovery:s0
    oneshot
    disabled

service tzts_service /vendor/bin/tzts_daemon
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/tee/vndk/lib64:/system/lib64
    seclabel u:r:recovery:s0
    oneshot
    disabled

service vendor.keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/tee/vndk/lib64:/system/lib64
    seclabel u:r:recovery:s0
    oneshot
    disabled

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user system
    group system 5678
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/tee/vndk/lib64:/system/lib64
    seclabel u:r:recovery:s0
    oneshot
    disabled
